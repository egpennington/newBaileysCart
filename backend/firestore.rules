rules_version = '2';

// WP-03 Slice 1: no direct client access to any document (Architecture v1.1 R-04 §A).
// All reads and writes go through authenticated callables using the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
